// datasource と generator はそのまま
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // もし MySQL を使っているなら "mysql" に書き換え
  url      = env("DATABASE_URL")
  // ここに directUrl = env("DIRECT_URL") がもしあったら、必ず消してください！
}

model User {
  id           String        @id @default(uuid())
  githubId     String        @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime      @default(now()) // いつ登録したか分かると便利
  dailyReports DailyReport[]
}

model DailyReport {
  id             String   @id @default(uuid())
  
  // 修正ポイント：最初は「誰のものか不明」でもOKなように ? をつけておきます
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  
  createdAt      DateTime @default(now())
  
  // ========== 基本情報 ==========
  title          String
  todayLearning  String
  struggles      String?
  tomorrow       String?

  // ========== GitHub統計 ==========
  githubUrl      String
  prCount        Int      @default(0)
  commitCount    Int      @default(0)
  linesChanged   Int      @default(0)
  changeSize     String   @default("M")
  
  // ========== AI生成コンテンツ ==========
  prSummary      String
  aiCoachComment String?
  
  // ========== 技術タグ ==========
  techTags       Json?
}